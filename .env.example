APP_NAME=CosplayIn
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Buat database MySQL terlebih dahulu:
#   CREATE DATABASE cosplayin CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cosplayin
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# CosplayIn: Payment Gateway (mock)
# ---------------------------------------------------------------------------
# TODO: Ganti ke Midtrans/Xendit saat gateway final diputuskan.
PAYMENT_GATEWAY=mock
MOCK_PAYMENT_KEY=cosplayin-mock-secret
MOCK_PAYMENT_ALLOW_SUCCESS=true

# Placeholder kredensial gateway final (belum dipakai).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# ---------------------------------------------------------------------------
# CosplayIn: Aturan Sewa & Biaya (nilai sementara)
# ---------------------------------------------------------------------------
RENTAL_MIN_DAYS=1
RENTAL_MAX_DAYS=14
DEFAULT_DEPOSIT=100000
DEFAULT_SHIPPING_FEE=25000
LATE_FEE_PER_DAY=50000
MAX_LATE_FEE=500000
PLATFORM_COMMISSION_PERCENT=10
DB_BACKUP_INTERVAL_HOURS=24

VITE_APP_NAME="${APP_NAME}"
